### Identity / Auth (JWT + Refresh + OTP via Aliyun SMS)
# JWT keys
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_PASSPHRASE=

# TTLs (seconds)
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=31536000

# Refresh token hashing secret (keep secret)
REFRESH_TOKEN_SECRET=

# OTP / Redis
OTP_TTL=300
OTP_REDIS_DSN=redis://localhost:6379/0

# Aliyun SMS
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_LOGIN_OTP=
ALIYUN_SMS_TEMPLATE_VERIFY_PHONE=
ALIYUN_SMS_DRY_RUN=true
