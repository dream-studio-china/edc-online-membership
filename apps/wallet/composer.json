{
    "name": "crud-platform/wallet-app",
    "description": "Wallet application for CRUD Platform",
    "version": "1.0.0-dev",
    "type": "project",
    "license": "Apache-2.0",
    "repositories": [
        { "type": "path", "url": "../../packages/integration-contracts", "options": { "symlink": false } },
        { "type": "path", "url": "../../packages/platform-kernel", "options": { "symlink": false } },
        { "type": "path", "url": "../identity", "options": { "symlink": false } }
    ],
    "require": {
        "php": ">=8.4",
        "crud-platform/integration-contracts": "^1.1.3@dev",
        "crud-platform/platform-kernel": "^1.0.3@dev",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "symfony/framework-bundle": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*"
        ,"symfony/translation": "8.1.*"
    },
    "require-dev": { "crud-platform/identity-app": "^1.0@dev", "phpunit/phpunit": "^12.5" },
    "autoload": { "psr-4": { "App\\Wallet\\": "src/" } },
    "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
    "config": { "allow-plugins": { "symfony/runtime": true } },
    "scripts": { "test": "@php vendor/bin/phpunit --configuration phpunit.xml" }
}
