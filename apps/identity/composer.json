{
    "name": "crud-platform/identity-app",
    "description": "Identity and WeChat login application for CRUD Platform",
    "version": "1.0.0-dev",
    "type": "project",
    "license": "Apache-2.0",
    "repositories": [
        { "type": "path", "url": "../../packages/integration-contracts", "options": { "symlink": false } },
        { "type": "path", "url": "../../packages/platform-kernel", "options": { "symlink": false } },
        { "type": "path", "url": "../payment", "options": { "symlink": false } }
    ],
    "require": {
        "alibabacloud/client": "^1.5",
        "php": ">=8.4",
        "crud-platform/platform-kernel": "^1.0.3@dev",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "symfony/cache": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/yaml": "8.1.*",
        "w7corp/easywechat": "^6.19"
    },
    "require-dev": { "crud-platform/integration-contracts": "^1.1.3@dev", "crud-platform/payment-app": "^1.0@dev", "phpunit/phpunit": "^12.5" },
    "autoload": { "psr-4": { "App\\Identity\\Main\\": "src/Main/", "App\\Identity\\Wechat\\": "src/Wechat/" } },
    "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
    "config": { "allow-plugins": { "symfony/runtime": true }, "sort-packages": true },
    "scripts": { "test": "@php vendor/bin/phpunit --configuration phpunit.xml" },
    "extra": { "symfony": { "allow-contrib": false, "require": "8.1.*" } }
}
